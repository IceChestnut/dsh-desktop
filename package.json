{
  "name": "dsh-desktop",
  "version": "0.1.0-rc.7",
  "private": true,
  "description": "Personal Electron shell for the DeepSeek Harness web GUI (transitional until the official desktop build)",
  "main": "main.js",
  "license": "MIT",
  "author": "Ice Chestnut",
  "scripts": {
    "start": "electron .",
    "harness": "node scripts/install-harness.js",
    "dist": "npm run harness && electron-builder --linux",
    "dist:win": "npm run harness && electron-builder --win",
    "dist:mac": "npm run harness && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.deepseek.dsh-desktop",
    "productName": "DSH Desktop",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "harness/node_modules", "to": "harness/node_modules" }
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "dsh-desktop-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "dsh-desktop-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "artifactName": "dsh-desktop-${version}-${arch}.${ext}"
    }
  }
}